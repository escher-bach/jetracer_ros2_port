ROS_DOMAIN_ID = 42
ROBOT_NAMESPACE = /bot1

# Dock this robot is physically placed on at boot, used to seed AMCL instead
# of clicking a pose in RViz. Must match a key in maps/docks/docks.yaml.
# MANUAL (or unset) keeps the RViz workflow.
# Placement rule: park the robot facing the lab's south at every dock -- the
# table's yaw assumes it.
RMF_START_DOCK=MANUAL