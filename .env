ROS_DOMAIN_ID = 42
ROBOT_NAMESPACE = /bot1

# Address of the machine running the Zenoh router (the remote/server machine).
# The robot dials out to it, so the server keeps no list of robot IPs and this
# robot can sit on DHCP or behind NAT without anything else being reconfigured.
# Must be set -- `docker compose up` fails with a message if it is left empty.
ROUTER_IP=

# Dock this robot is physically placed on at boot, used to seed AMCL instead
# of clicking a pose in RViz. Must match a key in docks/docks.yaml.
# MANUAL (or unset) keeps the RViz workflow.
# Placement rule: park the robot facing the lab's south at every dock -- the
# table's yaw assumes it.
RMF_START_DOCK=MANUAL
